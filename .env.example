# ── LLM Gateway V3 ──────────────────────────────────────────────────────────
# URL where the gateway listens. Default: http://localhost:8101
LLM_GATEWAY_V3_URL=http://localhost:8101

# Provider API keys — add only the ones you have
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=          # GitHub Models (free tier)

# Provider failover order (comma-separated). First healthy provider wins.
# LLM_ORDER=gemini,groq,nvidia,cerebras,openrouter,github

# Router order (for the tier-classification router pool)
# ROUTER_ORDER=cerebras,groq,nvidia,github

# ── MCP Server tools ────────────────────────────────────────────────────────
# Required by the example mcp_server_example.py (not the blank scaffold server)
TAVILY_API_KEY=        # Web search (Tavily primary)
# DuckDuckGo is used as fallback — no key needed
